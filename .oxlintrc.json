{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/consistent-type-imports": "error",
    "eqeqeq": "error",
    "no-console": "error"
  },
  "ignorePatterns": [
    "dist",
    "coverage"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
